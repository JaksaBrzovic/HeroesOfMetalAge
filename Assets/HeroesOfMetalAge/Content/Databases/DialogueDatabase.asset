%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 063fbe6563bb4284babfc299377efffd, type: 3}
  m_Name: DialogueDatabase
  m_EditorClassIdentifier: HeroesOfMetalAge.Dialogue::HeroesOfMetalAge.Dialogue.DialogueDatabaseScriptableObject
  charactersPerSecond: 80
  speakers:
  - id: kael
    displayName: KAEL IRONSONG
    portrait: {fileID: 21300000, guid: 7dfff008d102a4544880fe835e3c551d, type: 3}
  - id: lord-varg
    displayName: LORD VARG
    portrait: {fileID: 21300000, guid: 686059e4372f6b544a5210de3d17d236, type: 3}
  - id: air-guitarists
    displayName: AIR GUITARISTS
    portrait: {fileID: 21300000, guid: 07cb1f21f88af0d4fa1c4822f8a681e7, type: 3}
  - id: pass-wardens
    displayName: PASS WARDENS
    portrait: {fileID: 21300000, guid: f0ae6000f6087304f90e907529a6257a, type: 3}
  - id: black-banner
    displayName: THE BLACK BANNER
    portrait: {fileID: 0}
  - id: old-skald
    displayName: THE OLD SKALD
    portrait: {fileID: 21300000, guid: 4f09065db3bdefa4fa27dbc7b395e1fc, type: 3}
  - id: chained-maiden
    displayName: THE CHAINED MAIDEN
    portrait: {fileID: 21300000, guid: 4bbd998bd907a094cbf126214faf4d63, type: 3}
  - id: bone-oracle
    displayName: THE BONE ORACLE
    portrait: {fileID: 21300000, guid: cdac5cf9d38d28047b8667329f2801f0, type: 3}
  conversations:
  - id: ashen-pass-arrival
    style: 0
    lines:
    - id: ashen-pass-arrival-01
      speakerId: kael
      text: The Ashen Pass. Every road east runs through this valley, and every road
        here has a guard.
      voiceOver: {fileID: 0}
    - id: ashen-pass-arrival-02
      speakerId: lord-varg
      text: Turn back, bard. The Ashen Clan holds this pass, and the clan does not
        sell passage.
      voiceOver: {fileID: 0}
    - id: ashen-pass-arrival-03
      speakerId: kael
      text: Then I will not buy it. Strings up, banners high!
      voiceOver: {fileID: 0}
  - id: kael-ready
    style: 0
    lines:
    - id: kael-ready-01
      speakerId: kael
      text: Ready when you are.
      voiceOver: {fileID: 0}
  - id: friendly-arrival
    style: 0
    lines:
    - id: friendly-arrival-01
      speakerId: air-guitarists
      text: Di si legeeendo, mi bi se tebi pridruzili
      voiceOver: {fileID: 0}
  - id: sentinel-arrival
    style: 0
    lines:
    - id: sentinel-arrival-01
      speakerId: pass-wardens
      text: Preko nas mrtvih
      voiceOver: {fileID: 0}
  - id: town-arrival
    style: 1
    lines:
    - id: town-arrival-01
      speakerId: lord-varg
      text: "Stran\u010De, state your biznis"
      voiceOver: {fileID: 0}
  - id: boss-arrival
    style: 1
    lines:
    - id: boss-arrival-01
      speakerId: black-banner
      text: Ti si looood
      voiceOver: {fileID: 0}
  - id: quest-bearer
    style: 0
    lines:
    - id: quest-bearer-01
      speakerId: old-skald
      text: Hail, warlord of the iron oath. Hear an old man before you ride east.
      voiceOver: {fileID: 0}
    - id: quest-bearer-02
      speakerId: old-skald
      text: Beyond the clan's castle, past the red tent, horned beasts keep a maiden
        in chains.
      voiceOver: {fileID: 0}
    - id: quest-bearer-03
      speakerId: old-skald
      text: Take this red key. The keepers of the tent open only for its bearer.
      voiceOver: {fileID: 0}
    - id: quest-bearer-04
      speakerId: kael
      text: Then I ride for her.
      voiceOver: {fileID: 0}
  - id: red-tent
    style: 0
    lines:
    - id: red-tent-01
      speakerId: kael
      text: A red tent bars the way. Somewhere in the green lands someone must hold
        its key.
      voiceOver: {fileID: 0}
  - id: maiden-freed
    style: 0
    lines:
    - id: maiden-freed-01
      speakerId: chained-maiden
      text: You broke my chains, rider of the oath.
      voiceOver: {fileID: 0}
    - id: maiden-freed-02
      speakerId: chained-maiden
      text: The halls of femdom had been restored. Take the chain that bound me;
        let it bind your enemies.
      voiceOver: {fileID: 0}
    - id: maiden-freed-03
      speakerId: kael
      text: I will wear it with honour.
      voiceOver: {fileID: 0}
  - id: dragon-lore
    style: 0
    lines:
    - id: dragon-lore-01
      speakerId: bone-oracle
      text: Bones remember what the living forget.
      voiceOver: {fileID: 0}
    - id: dragon-lore-02
      speakerId: bone-oracle
      text: Under the burning mountains a dragon sleeps. When the Secret of Metal
        is sung, it will wake.
      voiceOver: {fileID: 0}
    - id: dragon-lore-03
      speakerId: kael
      text: Let it sleep. For now.
      voiceOver: {fileID: 0}
